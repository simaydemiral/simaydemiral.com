{
  "name": "FlashCards",
  "short_name": "FlashCards",
  "description": "Moved to /flashcards/. This manifest stays so an app added to the home screen before the move still finds its icons.",
  "start_url": "/flashcards/",
  "scope": "/flashcards/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#171210",
  "theme_color": "#171210",
  "icons": [
    { "src": "/vocab/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/vocab/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/vocab/icon-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
